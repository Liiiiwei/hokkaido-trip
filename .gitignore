# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 執行計畫的暫存工作區
.superpowers/

# 規格與計畫含行程細節，只留在本機
docs/

# Playwright 的輸出
/test-results/
/playwright-report/
